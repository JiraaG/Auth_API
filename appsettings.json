{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "DefaultConnection": "Host=YOUR_HOST;Port=YOUR_PORT;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PWD;"
    },

    "EmailSettings": {
        "FromEmail": "YOUR_EMAIL_ADDRESS",
        "SenderName": "YOUR_SENDER_NAME",
        "SmtpHost": "YOUR_SMTP_HOST",
        "SmtpPort": "YOUR_SMTP_PORT",
        "SmtpUser": "YOUR_SMTP_USER",
        "SmtpPass": "YOUR_SMTP_PWD"
    }
}
