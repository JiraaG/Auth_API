@using Auth_API.Domain.Entities.Account.ViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/fonts/material-icon/css/material-design-iconic-font.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/scss/style.scss" />

</head>
<body>
    <section class="sign-in">
        <div class="container" style="margin-top: 5rem">
            <div class="signin-content">
                <div class="signin-image">
                    <figure><img src="~/images/signin-image.jpg" alt="sign in image" /></figure>
                    <a href="@Url.Action("Register", "Account", new { returnUrl = Model.ReturnUrl })" class="signup-image-link">Create an account</a>
                </div>

                <div class="signin-form">
                    <h2 class="form-title">Log in</h2>

                    <form asp-action="Login" asp-controller="Account" method="post" class="register-form" id="login-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="form-group">
                            <label for="Email"><i class="zmdi zmdi-account material-icons-name"></i></label>
                            <input asp-for="Email" class="form-control" placeholder="Your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label for="Password"><i class="zmdi zmdi-lock"></i></label>
                            <input asp-for="Password" class="form-control" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input asp-for="RememberLogin" id="RememberLogin" class="agree-term" type="checkbox" />
                            <label for="RememberLogin" class="label-agree-term">
                                <span><span></span></span>Remember me
                            </label>
                            <span asp-validation-for="RememberLogin" class="text-danger"></span>
                        </div>

                        @* <div class="form-group">
                            <input for="RememberLogin" class="agree-term" />
                            <label asp-for="RememberLogin" class="label-agree-term"><span><span></span></span>Remember me</label>
                        </div> *@

                        <div class="form-group form-button">
                            <input type="submit" name="signin" id="signin" class="form-submit" value="Log in" />
                        </div>
                    </form>

                    <div class="social-login">
                        <span class="social-label">Or login with</span>
                        <ul class="socials">
                            <li><a href="#"><i class="display-flex-center zmdi zmdi-facebook"></i></a></li>
                            <li><a href="#"><i class="display-flex-center zmdi zmdi-google"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}