@using Auth_API.Domain.Entities.Account.ViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/fonts/material-icon/css/material-design-iconic-font.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/scss/style.scss" />

    <style>
        /* Container per ogni opzione radio */
        .radio-option {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
        }
            /* Spazio fra il radio button e il testo */
            .radio-option input[type="radio"] {
                margin-right: 10px;
            }
            /* Label senza margini addizionali */
            .radio-option label {
                margin: 0;
            }

        /* Stile generale del form */
        .form-group {
            margin-bottom: 15px;
        }

        .label-agree-term {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .form-submit {
            padding: 10px 20px;
            background-color: #007BFF;
            border: none;
            color: #fff;
            font-size: 16px;
            cursor: pointer;
        }

            .form-submit:hover {
                background-color: #0056b3;
            }
    </style>
</head>
<body>
    <section class="signup">
        <div class="container" style="margin-top: 5rem">
            <div class="signup-content">
                <div class="signup-form">
                    <h2 class="form-title">Sign up</h2>
                    <form method="post" asp-action="Register" asp-controller="Account" class="register-form" id="register-form">
                        @Html.AntiForgeryToken()

                        <!-- Campo hidden per preservare il ReturnUrl -->
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="form-group">
                            <label for="FirstName"><i class="zmdi zmdi-assignment-account"></i></label>
                            <input asp-for="FirstName" id="FirstName" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="LastName"><i class="zmdi zmdi-assignment-account"></i></label>
                            <input asp-for="LastName" id="LastName" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="Email"><i class="zmdi zmdi-email"></i></label>
                            <input asp-for="Email" id="Email" placeholder="Your Email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="Password"><i class="zmdi zmdi-lock"></i></label>
                            <input asp-for="Password" id="Password" type="password" placeholder="Password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="ConfirmPassword"><i class="zmdi zmdi-lock-outline"></i></label>
                            <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" placeholder="Repeat your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input asp-for="AgreeTerm" id="AgreeTerm" class="agree-term" type="checkbox" />
                            <label for="AgreeTerm" class="label-agree-term">
                                <span><span></span></span>I agree all statements in
                                <a href="#" class="term-service">Terms of service</a>
                            </label>
                            <span asp-validation-for="AgreeTerm" class="text-danger"></span>
                        </div>

                        <!-- Sezione per la scelta del metodo di autenticazione a due fattori -->
                        <div class="form-group">
                            <label class="label-agree-term">Two Factor Authentication Method</label>
                            <div class="radio-option">
                                <input type="radio" id="authenticator" name="TwoFactorMethod" value="Authenticator"/>
                                <label for="authenticator">Authenticator App</label>
                            </div>
                            <div class="radio-option">
                                <input type="radio" id="emailFactor" name="TwoFactorMethod" value="Email" />
                                <label for="emailFactor" style="top: 80%;">Email</label>
                            </div>
                            <span asp-validation-for="TwoFactorMethod" class="text-danger"></span>
                        </div>

                        <div class="form-group form-button">
                            <input type="submit" name="signup" id="signup" class="form-submit" value="Register" />
                        </div> 
                    </form>
                </div>
                <div class="signup-image">
                    <figure><img src="~/images/signup-image.jpg" alt="sign up image" /></figure>
                    <a href="@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })" class="signup-image-link">I am already member</a>
                </div>
            </div>
        </div>
    </section>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}