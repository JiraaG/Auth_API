@using Auth_API.Domain.Entities.Account.ViewModel
@using Auth_API.Domain.Entities.Enum
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model Login2FAViewModel
@{
    ViewData["Title"] = "Login 2FA";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/Login2FA.css" />

</head>
<body>

    <div class="container" style="margin-top: 5rem;">
        <form asp-action="Login2FA" asp-controller="Account" method="post" id="twoFaForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="RememberMe" />
            <input type="hidden" asp-for="TwoFactorMethod" />

            <h1>TWO-FACTOR AUTHENTICATION</h1>
            @* Visualizza istruzioni diverse in base al metodo scelto *@
            @if (Model.TwoFactorMethod == TwoFactorMethodType.Email)
            {
                <p>
                    Ti abbiamo inviato un codice di autenticazione tramite email. Controlla la tua casella di posta e inserisci il codice qui sotto.
                </p>
            }
            else if (Model.TwoFactorMethod == TwoFactorMethodType.Authenticator)
            {
                <p>
                    Apri la tua app authenticator (ad es. Microsoft Authenticator o Google Authenticator) e inserisci il codice visualizzato qui sotto.
                </p>
            }
            else
            {
                <p>
                    Non hai nessun metodo per effettuare l'autenticazione a 2 fattori. Contatta il supporto.
                </p>
            }

            @* <div asp-validation-summary="ModelOnly" class="text-danger"></div> *@

            @if (Model.TwoFactorMethod == TwoFactorMethodType.Email || Model.TwoFactorMethod == TwoFactorMethodType.Authenticator)
            {
                <br />
                <p>Enter 6-digit code from your authenticator application</p>
                <br />

                <div class="form__group form__pincode">
                    @for (int i = 0; i < 6; i++)
                    {
                        @* <label asp-for="Pincode[@i].Value"></label> *@
                        <input asp-for="Pincode[@i].Value"
                               type="tel"
                               inputmode="numeric"
                               pattern="\d*"
                               maxlength="1"
                               placeholder="·"
                               autocomplete="off"
                               class="pincode-input"
                               style="width:3rem; height:3rem; font-size:1.5rem; text-align:center;" />
                        <span asp-validation-for="Pincode[@i].Value" class="text-danger"></span>
                    }

                    @* @for (int i = 0; i < 6; i++)
                {
                    <input asp-for="Pincode[@i]"
                           type="tel"
                           maxlength="1"
                           pattern="\d*"
                           tabindex="@(i+1)"
                           placeholder="·"
                           autocomplete="off"
                           class="pincode-input" />
                } *@

                    @* <span asp-validation-for="Pincode" class="text-danger"></span> *@
                </div>

                <div class="form__buttons">
                    <button type="submit" class="button button--primary">Continue</button>
                </div>
            }
        </form>
    </div>

    @* <div class="container" style="margin-top: 5rem">
        <h2>Autenticazione a Due Fattori</h2>

        @if (Model.TwoFactorMethod == TwoFactorMethodType.Email)
        {
            <p>
                Ti abbiamo inviato un codice di autenticazione tramite email. Controlla la tua casella di posta e inserisci il codice qui sotto.
            </p>
        }
        else if (Model.TwoFactorMethod == TwoFactorMethodType.Authenticator)
        {
            <p>
                Apri la tua app authenticator (ad es. Microsoft Authenticator o Google Authenticator) e inserisci il codice visualizzato qui sotto.
            </p>
        }
        else
