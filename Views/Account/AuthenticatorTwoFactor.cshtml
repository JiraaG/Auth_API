@using Auth_API.Domain.Entities.Account.ViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model AuthenticatorViewModel

@{
    ViewData["Title"] = "Configura Microsoft Authenticator";
}

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/Login2FA.css" />

</head>
<body>

    <div class="container" style="margin-top: 5rem;">
        <form asp-action="Authenticator2FA" asp-controller="Account" method="post" id="twoFaForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="SharedKey" />
            <input type="hidden" asp-for="QrCodeImageUrl" />

            <h1>Microsoft Authenticator</h1>
            <br />
            <p>Scansiona questo QR Code con Microsoft Authenticator o inserisci manualmente la chiave</p>
            <div class="text-center mb-2">
                <img src="@Model.QrCodeImageUrl" alt="QR Code Authenticator" class="img-fluid" style="max-height: 200px;" />
            </div>
            <p class="mb-2 text-center">
                <strong>Chiave segreta:</strong>
                <code>@Model.SharedKey</code>
            </p>
            <div class="form__group form__pincode">
                @for (int i = 0; i < 6; i++)
                {
                    @* <label asp-for="Pincode[@i].Value"></label> *@
                    <input asp-for="Pincode[@i].Value"
                            type="tel"
                            inputmode="numeric"
                            pattern="\d*"
                            maxlength="1"
                            placeholder="·"
                            autocomplete="off"
                            class="pincode-input"
                            style="width:3rem; height:3rem; font-size:1.5rem; text-align:center;" />
                    <span asp-validation-for="Pincode[@i].Value" class="text-danger"></span>
                }
            </div>

            <div class="form__buttons">
                <button type="submit" class="button button--primary">Continue</button>
            </div>
        </form>
    </div>

