    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const inputs = Array.from(document.querySelectorAll('.pincode-input'));
          const form = document.getElementById('twoFaForm');

          function sanitizeAndMove(e, idx) {
            // rimuovi tutto tranne cifre
            e.target.value = e.target.value.replace(/\D/g, '');
            if (e.target.value && idx < inputs.length - 1) {
              inputs[idx + 1].focus();
            }
            // submit automatico quando tutti pieni
            if (inputs.every(i => i.value.length === 1)) {
              form.submit();
            }
          }

          inputs.forEach((input, idx) => {
            input.addEventListener('input', e => sanitizeAndMove(e, idx));

            input.addEventListener('keydown', e => {
              if (e.key === 'Backspace' && input.value === '' && idx > 0) {
                inputs[idx - 1].focus();
              }
            });

            input.addEventListener('paste', e => {
              e.preventDefault();
              const pasted = (e.clipboardData || window.clipboardData).getData('text');
              const digits = pasted.replace(/\D/g, '').slice(0, inputs.length).split('');
              digits.forEach((d, i) => inputs[i].value = d);
              const next = inputs.find(i => i.value === '');
              (next || inputs[inputs.length - 1]).focus();
              if (inputs.every(i => i.value)) form.submit();
            });
          });
        });
    </script>

    @section Scripts {
        @await Html.PartialAsync("_ValidationScriptsPartial")
    }
</body>
</html>
